<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeOverlay" />

    <style name="ThemeOverlay.ControlColorError">
        <item name="colorControlNormal">@color/color_error</item>
        <item name="android:textColor">@color/color_error</item>
    </style>

    <!-- Shape tokens are deliberately independent from page layouts so screens can migrate incrementally. -->
    <style name="ShapeAppearance.Aurora.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Aurora.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Aurora.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Typography tokens for the XML/DataBinding migration path. -->
    <style name="TextAppearance.Aurora.DisplaySmall" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Aurora.HeadlineLarge" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Aurora.TitleLarge" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Aurora.TopLevelTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Aurora.SectionLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/aurora_primary</item>
    </style>

    <style name="TextAppearance.Aurora.TitleMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Aurora.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.Aurora.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Aurora.Navigation" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ShapeAppearance.Aurora.NavigationIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Aurora.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:width">56dp</item>
        <item name="android:height">28dp</item>
        <item name="marginHorizontal">12dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Aurora.NavigationIndicator</item>
        <item name="android:color">@color/aurora_secondary_container</item>
    </style>

    <style name="Widget.Aurora.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/aurora_surface_container</item>
        <item name="backgroundTint">@color/aurora_surface_container</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:minHeight">@dimen/main_navigation_height</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Aurora.BottomNavigation.ActiveIndicator</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemIconTint">@color/aurora_navigation_item</item>
        <item name="itemTextColor">@color/aurora_navigation_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Aurora.Navigation</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Aurora.Navigation</item>
        <item name="itemPaddingTop">5dp</item>
        <item name="itemPaddingBottom">7dp</item>
    </style>

    <style name="Widget.Aurora.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">64dp</item>
        <item name="android:background">@color/aurora_outline_variant</item>
        <item name="android:alpha">0.55</item>
    </style>

    <style name="Widget.Aurora.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/aurora_secondary_container</item>
        <item name="android:textColor">@color/aurora_on_secondary_container</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Aurora.Button.Icon.Filled" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.Aurora.Button.Tool" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">76dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textColor">@color/aurora_on_surface</item>
        <item name="iconTint">@color/aurora_primary</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>

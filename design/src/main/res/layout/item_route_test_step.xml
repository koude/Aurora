<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable name="step" type="String" />
        <variable name="label" type="String" />
        <variable name="value" type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_aurora_route_step"
            android:gravity="center"
            android:text="@{step}"
            android:textColor="@color/aurora_on_secondary_container"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{label}"
                android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                android:textColor="@color/aurora_on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{value}"
                android:textAppearance="@style/TextAppearance.Aurora.TitleMedium"
                android:textColor="@color/aurora_on_surface" />
        </LinearLayout>
    </LinearLayout>
</layout>

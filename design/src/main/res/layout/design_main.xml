<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="self" type="com.github.kr328.clash.design.MainDesign" />
        <variable name="clashRunning" type="boolean" />
        <variable name="forwarded" type="String" />
        <variable name="mode" type="String" />
        <variable name="profileName" type="String" />
        <variable name="downloadSpeed" type="String" />
        <variable name="uploadSpeed" type="String" />
        <variable name="hasProviders" type="boolean" />
        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="@{(float) self.surface.insets.top + 8}"
                android:paddingEnd="16dp"
                android:paddingBottom="@{(float) self.surface.insets.bottom + 104}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/aurora_connection_center"
                        android:textAppearance="@style/TextAppearance.Aurora.TopLevelTitle"
                        android:textColor="@color/aurora_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/aurora_notifications"
                        android:onClick="@{() -> self.request(Request.Placeholder)}"
                        android:text=""
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_baseline_notifications_none"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/aurora_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/aurora_download"
                                android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                                android:textColor="@color/aurora_on_surface_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@{downloadSpeed}"
                                android:textAppearance="@style/TextAppearance.Aurora.TitleMedium"
                                android:textColor="@color/aurora_on_surface" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/aurora_upload"
                                android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                                android:textColor="@color/aurora_on_surface_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@{uploadSpeed}"
                                android:textAppearance="@style/TextAppearance.Aurora.TitleMedium"
                                android:textColor="@color/aurora_on_surface" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mode_button"
                        style="@style/Widget.Aurora.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="8dp"
                        android:text="@{mode}"
                        app:icon="@drawable/ic_baseline_arrow_drop_down"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/aurora_on_secondary_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connection_button"
                        style="@style/Widget.Aurora.Button.Icon.Filled"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@{clashRunning ? @string/aurora_connected : @string/aurora_disconnected}"
                        android:onClick="@{() -> self.request(Request.ToggleStatus)}"
                        android:text=""
                        app:backgroundTint="@color/aurora_surface_variant"
                        app:icon="@drawable/ic_baseline_power_settings_new"
                        app:iconTint="@color/aurora_on_primary" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/aurora_surface_container"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/aurora_site_latency"
                                    android:textAppearance="@style/TextAppearance.Aurora.TitleMedium"
                                    android:textColor="@color/aurora_on_surface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/aurora_site_latency_summary"
                                    android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                                    android:textColor="@color/aurora_on_surface_variant" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                style="@style/Widget.Aurora.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:onClick="@{() -> self.request(Request.Placeholder)}"
                                android:text="@string/aurora_test_all"
                                app:icon="@drawable/ic_baseline_replay"
                                app:iconTint="@color/aurora_on_secondary_container" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">
                            <include layout="@layout/item_home_latency" app:siteName="@{@string/apple}" />
                            <include layout="@layout/item_home_latency" app:siteName="@{@string/github}" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <include layout="@layout/item_home_latency" app:siteName="@{@string/youtube}" />
                            <include layout="@layout/item_home_latency" app:siteName="@{@string/google}" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/aurora_quick_tools"
                    android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                    android:textColor="@color/aurora_on_surface_variant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Aurora.Button.Tool"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> self.request(Request.Placeholder)}"
                        android:text="@string/aurora_connections"
                        app:icon="@drawable/ic_baseline_apps" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Aurora.Button.Tool"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> self.request(Request.OpenLogs)}"
                        android:text="@string/logs"
                        app:icon="@drawable/ic_baseline_assignment" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Aurora.Button.Tool"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> self.request(Request.Placeholder)}"
                        android:text="@string/aurora_route_test"
                        app:icon="@drawable/ic_baseline_swap_vertical_circle" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Aurora.Button.Tool"
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_weight="1"
                        android:onClick="@{() -> self.request(Request.Placeholder)}"
                        android:text="@string/dns"
                        app:icon="@drawable/ic_baseline_dns" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/aurora_surface_container"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{profileName != null ? profileName : @string/aurora_profile_placeholder}"
                                android:textAppearance="@style/TextAppearance.Aurora.TitleMedium"
                                android:textColor="@color/aurora_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/aurora_profile_usage_placeholder"
                                android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                                android:textColor="@color/aurora_on_surface_variant" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Aurora.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:onClick="@{() -> self.request(Request.OpenProfiles)}"
                            android:text="@string/profiles" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/aurora_surface_container"
            android:paddingBottom="@{self.surface.insets.bottom}"
            android:clipToPadding="false">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/navigation"
                style="@style/Widget.Aurora.BottomNavigation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/main_navigation_height"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_main_navigation" />
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>

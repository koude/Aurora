<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aurora_route_test"
            android:textAppearance="@style/TextAppearance.Aurora.TitleLarge"
            android:textColor="@color/aurora_on_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/route_target_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/aurora_route_target_hint"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/route_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:text="github.com" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/route_test_button"
                style="@style/Widget.Aurora.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/aurora_route_test_action" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:text="@string/aurora_route_test_note"
            android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
            android:textColor="@color/aurora_on_surface_variant" />

        <TextView
            android:id="@+id/route_empty"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="@string/aurora_route_empty"
            android:textAppearance="@style/TextAppearance.Aurora.BodyLarge"
            android:textColor="@color/aurora_on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/route_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/aurora_surface_container_high"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <include
                    android:id="@+id/route_target_row"
                    layout="@layout/item_route_test_step"
                    app:label="@{@string/aurora_route_target_label}"
                    app:step='@{"1"}'
                    app:value="@{@string/aurora_route_result_unknown}" />

                <include
                    android:id="@+id/route_rule_row"
                    layout="@layout/item_route_test_step"
                    app:label="@{@string/aurora_route_rule_label}"
                    app:step='@{"2"}'
                    app:value="@{@string/aurora_route_result_unknown}" />

                <include
                    android:id="@+id/route_policy_row"
                    layout="@layout/item_route_test_step"
                    app:label="@{@string/aurora_route_policy_label}"
                    app:step='@{"3"}'
                    app:value="@{@string/aurora_route_result_unknown}" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@color/aurora_primary_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_aurora_route_step_primary"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@color/aurora_on_primary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aurora_route_outbound_label"
                            android:textAppearance="@style/TextAppearance.Aurora.BodyMedium"
                            android:textColor="@color/aurora_on_primary_container" />

                        <TextView
                            android:id="@+id/route_outbound_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/aurora_route_result_unknown"
                            android:textAppearance="@style/TextAppearance.Aurora.TitleMedium"
                            android:textColor="@color/aurora_on_primary_container" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</layout>
